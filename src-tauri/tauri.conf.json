{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskWizard",
  "version": "0.4.0",
  "identifier": "com.heicfast.diskwizard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "DiskWizard",
        "label": "main",
        "width": 1240,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximized": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DiskWizard",
    "category": "Utility",
    "shortDescription": "Windows data recovery wizard and safe disk cleanup",
    "longDescription": "DiskWizard finds lost and deleted files with a raw NTFS engine, recovers them safely, visualizes disk usage, and cleans up with a guaranteed undo.",
    "copyright": "Copyright (C) 2026 DiskWizard contributors. Licensed under GPL-3.0-or-later.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": true,
        "headerImage": "nsis-header.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/heicfast/d-space_fork/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NTNGRTgzRjBDQjUyNUUKUldSZVVzdndnLzVUT0NLS3BFZHk1cTZhUkZZVVZEREhhVVM5UHdGOWgrK1RVVlBXZitrcVBuc00K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
